# .env.example — Vega VPN Portal Stack
# Copy to .env and fill in real values:
#   cp .env.example .env
# Then populate marzban/.env from the MARZBAN_* vars below.

# ============================================================
# === DOMAIN & URLs (required)
# ============================================================

# Your public VPN domain (used in Marzban subscription URLs, portal JS, Caddy config)
PORTAL_BASE_URL=https://vpn.example.com

# Your server's public IP address (used in xray_config.json listen fields)
YOUR_SERVER_IP=YOUR_SERVER_IP

# ============================================================
# === MARZBAN (required)
# ============================================================

# Marzban admin credentials — set before first docker compose up
MARZBAN_SUDO_USERNAME=admin
MARZBAN_SUDO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Marzban JWT signing key — generate with: openssl rand -hex 32
MARZBAN_JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Marzban token expiry (minutes) — default 1440 = 24h
MARZBAN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# === XRAY / REALITY (required — generate fresh keys, never reuse)
# ============================================================

# Generate a new keypair: docker run --rm teddysun/xray xray x25519
# Or locally: xray x25519
REALITY_PRIVATE_KEY=REPLACE_ME_REALITY_PRIVATE_KEY
REALITY_SHORT_ID=REPLACE_ME_REALITY_SHORT_ID

# Shadowsocks 2022 password — generate with: openssl rand -base64 32
SS_PASSWORD=REPLACE_ME_SS_PASSWORD

# ============================================================
# === CADDY ADMIN GATE (required)
# ============================================================

# Random token guarding /setup + /dashboard in caddy-vpn.conf
# Generate with: openssl rand -hex 24
# Must replace every REPLACE_ME_ADMIN_PASS in caddy-vpn.conf
CADDY_ADMIN_PASS_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24

# ============================================================
# === STATS DAEMON (optional — host process, not Docker)
# ============================================================

# Directory where stats-daemon.py writes JSON (mounted read-only into portal container)
STATS_OUT_DIR=./portal/html/stats

# ============================================================
# === BACKUP (optional)
# ============================================================

BACKUP_DIR=./backups
