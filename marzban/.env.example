# marzban/.env  — placeholder template (gitignored, no real secrets)
# Populate from .env.example at repo root:
#   cp .env.example marzban/.env   (then fill in real values)

SUDO_USERNAME=${MARZBAN_SUDO_USERNAME}
SUDO_PASSWORD=${MARZBAN_SUDO_PASSWORD}

UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

SQLALCHEMY_DATABASE_URL="sqlite:////var/lib/marzban/db.sqlite3"

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_SECRET_KEY=${MARZBAN_JWT_SECRET_KEY}

XRAY_SUBSCRIPTION_URL_PREFIX=${PORTAL_BASE_URL}
XRAY_JSON=/code/xray_config.json

TZ=Europe/Berlin
DOCS=False
DEBUG=False
